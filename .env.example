# ============================================================
# Travel Genius - 环境变量配置模板
# 复制本文件为 .env 并填入你的密钥：cp .env.example .env
# ============================================================

# 通用 OpenAI API 密钥（作为默认 fallback）
OPENAI_API_KEY=

# ── 第三方工具 API（可选）────────────────────────────────────
# SerpAPI — Google Maps 地点搜索（不填则使用内置备用数据）
SERPAPI_API_KEY=

# OpenWeatherMap — 天气查询（不填则跳过天气验证）
OPENWEATHERMAP_API_KEY=

# ── Agent A: 灵感探索者 模型配置 ─────────────────────────────
EXPLORER_MODEL=mimo-v2.5-pro
EXPLORER_MODEL_API_KEY=your_mimo_api_key_here
EXPLORER_MODEL_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# ── Agent B: 精明决策者 模型配置 ─────────────────────────────
DECISION_MODEL=deepseek-chat
DECISION_MODEL_API_KEY=your_deepseek_api_key_here
DECISION_MODEL_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 其他可用配置示例
# ============================================================
# --- OpenAI ---
# EXPLORER_MODEL=gpt-4o-mini
# EXPLORER_MODEL_API_KEY=sk-xxx
# EXPLORER_MODEL_BASE_URL=
#
# --- 本地 Ollama ---
# EXPLORER_MODEL=ollama/qwen2.5:7b
# EXPLORER_MODEL_BASE_URL=http://localhost:11434
