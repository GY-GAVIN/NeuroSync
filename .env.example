# ============================================================
# NeuroSync - 环境变量配置模板
# 复制本文件为 .env 并填入配置：cp .env.example .env
# ============================================================

# 通用 API 密钥（作为默认 fallback）
OPENAI_API_KEY=

# ── Agent 1: 博弈建模师 ────────────────────────────────────
MODELER_MODEL=gpt-4o
MODELER_MODEL_API_KEY=
MODELER_MODEL_BASE_URL=

# ── Agent 2: 均衡分析师 ────────────────────────────────────
ANALYST_MODEL=gpt-4o
ANALYST_MODEL_API_KEY=
ANALYST_MODEL_BASE_URL=

# ── Agent 3: 策略顾问 ──────────────────────────────────────
ADVISOR_MODEL=gpt-4o
ADVISOR_MODEL_API_KEY=
ADVISOR_MODEL_BASE_URL=
