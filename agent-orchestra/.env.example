# ============================================================
# Travel Genius - 双模型 API 配置
# ============================================================

# 通用 OpenAI API 密钥（作为默认 fallback）
OPENAI_API_KEY=your_openai_api_key_here

# ── Agent A: 灵感探索者 模型配置 ─────────────────────────────
# 支持 OpenAI 兼容格式的任意 API（OpenAI / DeepSeek / 通义千问 / 本地模型等）
EXPLORER_MODEL=gpt-4o-mini
# EXPLORER_MODEL_API_KEY=sk-xxx          # 如不填，回退到 OPENAI_API_KEY
# EXPLORER_MODEL_BASE_URL=               # 自定义 API 地址（留空则用 OpenAI 官方）

# ── Agent B: 精明决策者 模型配置 ─────────────────────────────
DECISION_MODEL=gpt-4o
# DECISION_MODEL_API_KEY=sk-xxx          # 如不填，回退到 OPENAI_API_KEY
# DECISION_MODEL_BASE_URL=               # 自定义 API 地址（留空则用 OpenAI 官方）

# ============================================================
# 示例：使用 DeepSeek API
# ============================================================
# EXPLORER_MODEL=deepseek-chat
# EXPLORER_MODEL_API_KEY=sk-deepseek-xxx
# EXPLORER_MODEL_BASE_URL=https://api.deepseek.com/v1
#
# DECISION_MODEL=deepseek-reasoner
# DECISION_MODEL_API_KEY=sk-deepseek-xxx
# DECISION_MODEL_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 示例：使用本地 Ollama
# ============================================================
# EXPLORER_MODEL=ollama/qwen2.5:7b
# EXPLORER_MODEL_BASE_URL=http://localhost:11434
#
# DECISION_MODEL=ollama/qwen2.5:14b
# DECISION_MODEL_BASE_URL=http://localhost:11434
